+        # never leaks into the user-facing reply (show_reasoning=false).
+        text: list = []
+        reasoning: list = []
+
+        def update(kind: str, chunk: str | None = None) -> None:
+            u: dict = {"sessionUpdate": kind}
+            if chunk is not None:
